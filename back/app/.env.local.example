APP_ENV=dev
APP_SECRET=replace-with-a-random-local-secret

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3307
DATABASE_DB=tiptop
DATABASE_USERNAME=replace-with-local-mysql-user
DATABASE_PASSWORD=replace-with-local-mysql-password
DATABASE_ROOT_PASSWORD=replace-with-local-mysql-root-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
FACEBOOK_CLIENT_ID=replace-with-facebook-client-id
FACEBOOK_CLIENT_SECRET=replace-with-facebook-client-secret